import spawn

# The default: a real fault (division by zero) in one child. Structured
# concurrency is fail-fast — the nursery cancels the siblings and the
# failure takes the whole program down with exit 1.
fn worker(id: Int) : Int / Stdout =
  if id == 2 { 10 / (id - 2) }
  else { Stdout.print("worker #{int_to_string(id)} ok"); id }

fn main() : Int / Spawn + Stdout = {
  nursery { n ->
    let fibers = [1, 2, 3] | (i => n.spawn(() => worker(i)))
    fibers | (f => n.await(f))
  }
  Stdout.print("all joined")
  0
}
