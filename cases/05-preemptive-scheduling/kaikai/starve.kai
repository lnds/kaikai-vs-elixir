import spawn

# A pure CPU loop: no I/O, no yield points. Under a cooperative
# scheduler nothing else runs until it finishes.
fn hog(i: Int, limit: Int) : Int =
  if i >= limit { i } else { hog(i + 1, limit) }

fn heartbeat(k: Int) : Unit / Stdout =
  if k == 0 { () }
  else {
    Stdout.print("heartbeat #{int_to_string(k)}")
    heartbeat(k - 1)
  }

fn main() : Int / Spawn + Stdout = {
  nursery { n ->
    let h = n.spawn(() => {
      let r = hog(0, 300000000)
      Stdout.print("hog done: #{int_to_string(r)}")
      ()
    })
    let b = n.spawn(() => heartbeat(3))
    n.await(h)
    n.await(b)
  }
  0
}
